{
  "appId": "com.ciptakaryagresik.kendati",
  "appName": "KENDATI",
  "webDir": "www",
  "backgroundColor": "#071b3a",
  "appendUserAgent": "KendatiApp",
  "zoomEnabled": true,
  "server": {
    "url": "https://ppbltahun2025.github.io/",
    "errorPath": "offline.html",
    "cleartext": false,
    "allowNavigation": [
      "ppbltahun2025.github.io",
      "*.github.io",
      "script.google.com",
      "*.googleusercontent.com",
      "*.supabase.co",
      "api.github.com",
      "raw.githubusercontent.com"
    ]
  },
  "android": {
    "backgroundColor": "#071b3a",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#071b3a",
    "contentInset": "automatic",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  }
}